diff --git a/Snarro/App/DemoShots.swift b/Snarro/App/DemoShots.swift
new file mode 100644
index 0000000..bae9734
--- /dev/null
+++ b/Snarro/App/DemoShots.swift
@@ -0,0 +1,136 @@
+#if DEBUG
+import AppKit
+import ScreenCaptureKit
+
+/// TEMPORARY, do not commit: real window screenshots for the website.
+/// `SNARRO_DEMO_DIR=<dir> Snarro` reads `<dir>/fixtures/*.png`, writes `<dir>/shots/*.png` and quits.
+/// Uses its own UserDefaults suite, so the user's settings are not touched.
+@MainActor
+enum DemoShots {
+    private static var keepAlive: [AnyObject] = []
+
+    /// True when demo mode took over the launch.
+    static func runIfRequested() -> Bool {
+        guard let path = ProcessInfo.processInfo.environment["SNARRO_DEMO_DIR"] else { return false }
+        let dir = URL(fileURLWithPath: path)
+        Task { @MainActor in
+            do {
+                try await run(dir: dir)
+            } catch {
+                print("DemoShots failed: \(error)")
+            }
+            NSApp.terminate(nil)
+        }
+        return true
+    }
+
+    private static func run(dir: URL) async throws {
+        let out = dir.appendingPathComponent("shots")
+        try FileManager.default.createDirectory(at: out, withIntermediateDirectories: true)
+        let suite = "com.asanosmanov.Snarro.demo"
+        UserDefaults().removePersistentDomain(forName: suite)
+        let defaults = UserDefaults(suiteName: suite)!
+        NSApp.setActivationPolicy(.regular)
+
+        for (themeName, appearance) in [("light", NSAppearance.Name.aqua), ("dark", .darkAqua)] {
+            NSApp.appearance = NSAppearance(named: appearance)
+
+            try await editorShot("orders", tool: .arrowTool, defaults: defaults, to: out.appendingPathComponent("editor-arrow-\(themeName).png")) { style in
+                [ArrowAnnotation(start: CGPoint(x: 1250, y: 1115), end: CGPoint(x: 1640, y: 748), text: "здесь неверный статус", style: style)]
+            }
+            try await editorShot("account", tool: .redactTool, defaults: defaults, to: out.appendingPathComponent("editor-redact-\(themeName).png")) { style in
+                [
+                    RedactionAnnotation(rect: CGRect(x: 492, y: 374, width: 420, height: 56), kind: .blur),
+                    RedactionAnnotation(rect: CGRect(x: 492, y: 468, width: 280, height: 54), kind: .pixelate),
+                    RedactionAnnotation(rect: CGRect(x: 492, y: 606, width: 326, height: 56), kind: .blackout),
+                    RectangleAnnotation(rect: CGRect(x: 1190, y: 796, width: 402, height: 104), style: style),
+                ]
+            }
+            try await editorShot("orders", tool: .rectangleTool, defaults: defaults, to: out.appendingPathComponent("editor-mix-\(themeName).png")) { style in
+                [
+                    RectangleAnnotation(rect: CGRect(x: 1636, y: 682, width: 218, height: 72), style: style),
+                    TextAnnotation(position: CGPoint(x: 1236, y: 1112), text: "Проверить статус #10480", style: style),
+                ]
+            }
+            for tab in [SettingsWindowController.Tab.shortcuts, .editor] {
+                try await settingsShot(tab, defaults: defaults, to: out.appendingPathComponent("settings-\(tab)-\(themeName).png"))
+            }
+        }
+        UserDefaults().removePersistentDomain(forName: suite)
+    }
+
+    private static func editorShot(
+        _ fixture: String,
+        tool: AppCommand,
+        defaults: UserDefaults,
+        to url: URL,
+        annotations: (AnnotationStyle) -> [any Annotation]
+    ) async throws {
+        let source = CGImageSourceCreateWithURL(URL(fileURLWithPath: ProcessInfo.processInfo.environment["SNARRO_DEMO_DIR"]!)
+            .appendingPathComponent("fixtures/\(fixture).png") as CFURL, nil)!
+        let image = CGImageSourceCreateImageAtIndex(source, 0, nil)!
+        let screen = NSScreen.main!
+        let capture = CapturedImage(cgImage: image, scale: 2, displayID: screen.displayID ?? CGMainDisplayID())
+        let editor = EditorController(
+            capture: capture,
+            bindings: ShortcutSettings(defaults: defaults).bindings,
+            settings: EditorSettings(defaults: defaults)
+        )
+        _ = editor.debugSession.perform(tool)
+        for annotation in annotations(.defaults) {
+            editor.debugSession.draft = annotation
+            editor.debugSession.commitDraft()
+        }
+        editor.show()
+        try await Task.sleep(for: .seconds(1.2))
+        try await snapshot(editor.debugWindow, to: url)
+        editor.closeWithoutSaving()
+        try await Task.sleep(for: .seconds(0.4))
+    }
+
+    private static func settingsShot(_ tab: SettingsWindowController.Tab, defaults: UserDefaults, to url: URL) async throws {
+        let shortcutSettings = ShortcutSettings(defaults: defaults)
+        let controller = SettingsWindowController(dependencies: .init(
+            app: AppSettings(defaults: defaults),
+            launchAtLogin: LaunchAtLogin(),
+            capture: CaptureSettings(defaults: defaults),
+            editor: EditorSettings(defaults: defaults),
+            export: ExportSettings(defaults: defaults),
+            shortcuts: ShortcutEditor(settings: shortcutSettings) { _ throws(AppError) in },
+            recorder: ShortcutRecorder()
+        ))
+        keepAlive.append(controller)
+        controller.show(tab)
+        try await Task.sleep(for: .seconds(1.5))
+        guard let window = NSApp.windows.first(where: { $0.isVisible && $0.title == tab.title }) else {
+            print("DemoShots: no settings window for \(tab)")
+            return
+        }
+        try await snapshot(window, to: url)
+        window.close()
+        try await Task.sleep(for: .seconds(0.4))
+    }
+
+    /// The window as the screen shows it, with its shadow, on a transparent background.
+    private static func snapshot(_ window: NSWindow, to url: URL) async throws {
+        let content = try await SCShareableContent.excludingDesktopWindows(false, onScreenWindowsOnly: true)
+        guard let scWindow = content.windows.first(where: { $0.windowID == CGWindowID(window.windowNumber) }) else {
+            print("DemoShots: window not found for \(url.lastPathComponent)")
+            return
+        }
+        let filter = SCContentFilter(desktopIndependentWindow: scWindow)
+        let config = SCStreamConfiguration()
+        config.ignoreShadowsSingleWindow = false
+        config.showsCursor = false
+        config.captureResolution = .best
+        let scale = CGFloat(filter.pointPixelScale)
+        config.width = Int(filter.contentRect.width * scale)
+        config.height = Int(filter.contentRect.height * scale)
+        let image = try await SCScreenshotManager.captureImage(contentFilter: filter, configuration: config)
+        let destination = CGImageDestinationCreateWithURL(url as CFURL, "public.png" as CFString, 1, nil)!
+        CGImageDestinationAddImage(destination, image, nil)
+        CGImageDestinationFinalize(destination)
+        print("DemoShots: \(url.lastPathComponent) \(image.width)×\(image.height)")
+    }
+}
+#endif
